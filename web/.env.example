# TIL USER CRM — Environment Variables EXAMPLE
# Скопируйте этот файл в .env и заполните реальные значения

# JWT
SECRET_KEY=your-super-secret-key-at-least-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./education_center_web.db

# CORS — через запятую
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
