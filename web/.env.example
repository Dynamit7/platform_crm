# TIL USER CRM — Environment Variables EXAMPLE
# Скопируйте этот файл в .env и заполните реальные значения

# JWT
SECRET_KEY=your-super-secret-key-at-least-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite по умолчанию, PostgreSQL для production)
DATABASE_URL=sqlite:///./education_center.db
# DATABASE_URL=postgresql://smartedu:smartedu_secret@db:5432/education_crm

# CORS — через запятую
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Super Admin (создаётся автоматически при первом запуске)
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_PASSWORD=changeme123
